{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "starlight-workers",
    "main": "src/index.ts", // 直接指向源文件
    "compatibility_date": "2026-08-20",
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "sl-db",
            "database_id": "d8281870-5d02-4d2f-ba45-b8821d2683c2"
        }
    ],
    // 构建配置（生产部署时使用）
    // "build": {
    //     "command": "npm run build",
    //     "watch_dir": "src"
    // },
    // 开发环境变量（可选）
    "vars": {
        "ENVIRONMENT": "development"
    }
}
