{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "starlight-workers",
    "main": "src/index.ts", // 直接指向源文件
    "compatibility_date": "2026-08-20",
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "sl-db",
            "database_id": "d8281870-5d02-4d2f-ba45-b8821d2683c2",
            "migrations_dir": "migrations"
        }
    ],
    "ratelimits": [
        {
            "name": "LOGIN_RATE_LIMITER",
            "namespace_id": "154154",
            "simple": { "limit": 10, "period": 60 }
        },
        {
            "name": "REGISTER_RATE_LIMITER",
            "namespace_id": "154155",
            "simple": { "limit": 5, "period": 60 }
        },
        {
            "name": "CHECKIN_RATE_LIMITER",
            "namespace_id": "154156",
            "simple": { "limit": 5, "period": 60 }
        },
        {
            "name": "ECONOMY_RATE_LIMITER",
            "namespace_id": "154157",
            "simple": { "limit": 10, "period": 60 }
        }
    ],
    // 构建配置（生产部署时使用）
    // "build": {
    //     "command": "npm run build",
    //     "watch_dir": "src"
    // },
    // 开发环境变量（可选）
    "vars": {
        "ENVIRONMENT": "development"
    }
}
